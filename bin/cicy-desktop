#!/usr/bin/env node
const { spawn, execSync, execFileSync } = require("child_process");
const path = require("path");
const fs = require("fs");
const os = require("os");
const isWindows = process.platform === "win32";
const { MasterTokenManager } = require("../src/master/master-main");
const { version: CLI_VERSION } = require("../package.json");

const HOME = os.homedir();
const DESKTOP_DIR = path.join(HOME, "Desktop");
const GLOBAL_CONFIG_FILE = path.join(HOME, "global.json");
const STATE_FILE = path.join(HOME, ".cicy-cluster.json");
const LOGS_DIR = path.join(HOME, "logs");
const PACKAGE_ROOT = path.join(__dirname, "..");
// CN/global defaults: a fresh machine has no cached electron binary, so the
// electron postinstall (and our own self-provisioning below) would otherwise
// hit GitHub releases, which is slow/blocked on many networks. Default to our
// own Aliyun OSS mirror — the three platform zips we ship are mirrored at
// <ELECTRON_MIRROR>v<version>/electron-v<version>-<platform>.zip (+ SHASUMS256.txt),
// the exact layout @electron/get expects. Overridable via the env var.
const ELECTRON_MIRROR = process.env.ELECTRON_MIRROR || "https://cicy-1372193042-cn.oss-cn-shanghai.aliyuncs.com/electron/";
const NPM_REGISTRY = process.env.CICY_NPM_REGISTRY || process.env.npm_config_registry || "https://registry.npmmirror.com";
const MASTER_ENTRY = path.join(PACKAGE_ROOT, "src", "master", "master-main.js");

// Resolve a globally-installed electron (`npm i -g electron`), so the ~200MB
// binary is downloaded once and SHARED across cicy tools / desktop versions
// instead of one copy per package install. Returns null if not present.
let _globalElectronBin; // memoized (avoid re-spawning `npm prefix -g`)
function globalElectronBin() {
  if (_globalElectronBin !== undefined) return _globalElectronBin;
  _globalElectronBin = null;
  try {
    const prefix = execSync("npm prefix -g", { stdio: ["ignore", "pipe", "ignore"] })
      .toString().trim();
    if (prefix) {
      const p = isWindows
        ? path.join(prefix, "electron.cmd")
        : path.join(prefix, "bin", "electron");
      if (fs.existsSync(p)) _globalElectronBin = p;
    }
  } catch { /* keep null */ }
  return _globalElectronBin;
}

// Pinned electron version = the one cicy-desktop is built against (package.json
// dependency). NEVER install "latest": its native extract-zip prebuild is
// unpublished for win32-x64 → `npm i -g electron` dies with "Cannot find native
// binding". 41.x downloads fine.
const ELECTRON_VERSION = (() => {
  try {
    const pj = require("../package.json");
    const v = (pj.dependencies && pj.dependencies.electron) ||
              (pj.devDependencies && pj.devDependencies.electron) || "";
    return String(v).replace(/^[\^~>=\s]*/, "").trim() || "41.0.3";
  } catch { return "41.0.3"; }
})();

// True iff <electronDir> has a downloaded, runnable binary (path.txt → dist/exe).
function electronBinaryHealthy(electronDir) {
  if (!electronDir) return false;
  try {
    const exe = fs.readFileSync(path.join(electronDir, "path.txt"), "utf8").trim();
    return !!exe && fs.existsSync(path.join(electronDir, "dist", exe));
  } catch { return false; }
}

// The GLOBAL electron's package dir for the current npm prefix (null if none).
function globalElectronDir() {
  try {
    const prefix = execSync("npm prefix -g", { stdio: ["ignore", "pipe", "ignore"] }).toString().trim();
    if (!prefix) return null;
    return isWindows
      ? path.join(prefix, "node_modules", "electron")          // win: <prefix>\node_modules\electron
      : path.join(prefix, "lib", "node_modules", "electron");  // unix: <prefix>/lib/node_modules/electron
  } catch { return null; }
}

// The per-platform Electron artifact (mirror zip name + the in-dist executable
// that path.txt must point at).
function electronArtifact() {
  const plat = process.platform === "win32" ? "win32" : process.platform === "darwin" ? "darwin" : "linux";
  const arch = process.arch === "arm64" ? "arm64" : "x64";
  return {
    zip: `electron-v${ELECTRON_VERSION}-${plat}-${arch}.zip`,
    exe: process.platform === "win32" ? "electron.exe"
       : process.platform === "darwin" ? "Electron.app/Contents/MacOS/Electron"
       : "electron",
  };
}

// Provision the Electron binary INTO the bundled npx copy ourselves: download the
// platform zip from the mirror (R2) with curl, extract with the OS's own unzip,
// then write path.txt. We deliberately do NOT use electron's install.js /
// @electron/get: on Windows its bundled extract-zip only PARTIALLY unpacks
// electron 41 (leaves no path.txt → "Electron failed to install correctly") even
// though the downloaded zip is valid. curl + Expand-Archive/unzip is reliable,
// mirror-only (no GitHub), and writes a complete dist/.
function provisionElectronFromMirror(bundledDir) {
  const { zip, exe } = electronArtifact();
  const url = `${ELECTRON_MIRROR}v${ELECTRON_VERSION}/${zip}`;
  const tmpZip = path.join(os.tmpdir(), `cicy-${zip}`);
  const curl = isWindows ? "curl.exe" : "curl";
  execFileSync(curl, ["-fL", "--retry", "5", "--retry-delay", "2", "--connect-timeout", "20", "-o", tmpZip, url], { stdio: "inherit" });
  const distDir = path.join(bundledDir, "dist");
  fs.rmSync(distDir, { recursive: true, force: true });
  fs.mkdirSync(distDir, { recursive: true });
  if (isWindows) {
    execFileSync("powershell", ["-NoProfile", "-Command", `Expand-Archive -LiteralPath "${tmpZip}" -DestinationPath "${distDir}" -Force`], { stdio: "inherit" });
  } else {
    execFileSync("unzip", ["-o", "-q", tmpZip, "-d", distDir], { stdio: "inherit" });
    try { fs.chmodSync(path.join(distDir, exe), 0o755); } catch {}
  }
  fs.writeFileSync(path.join(bundledDir, "path.txt"), exe);
  try { fs.rmSync(tmpZip, { force: true }); } catch {}
}

// Make sure a USABLE electron exists before spawning the worker. A pre-existing
// GLOBAL electron is reused if present. Otherwise we provision the binary LOCALLY
// into the bundled npx copy straight from the R2 mirror — NO `npm i -g`, NO
// GitHub, NO @electron/get. This is what lets a single `npx cicy-desktop`
// self-provision electron and start first-try. Runs once per process.
let _electronEnsured = false;
function ensureElectron() {
  if (_electronEnsured) return;
  _electronEnsured = true;
  // Already usable (a shared global, or the resolvable bundled/npx copy)? done.
  if (electronBinaryHealthy(globalElectronDir())) return;
  let bundledDir = null;
  try { bundledDir = path.dirname(require.resolve("electron/package.json", { paths: [PACKAGE_ROOT] })); } catch {}
  if (electronBinaryHealthy(bundledDir)) return;
  if (!bundledDir) {
    console.warn(`⚠️  electron package not resolvable under ${PACKAGE_ROOT}; cannot self-provision.`);
    return;
  }
  console.log(`⚙️  Fetching Electron ${ELECTRON_VERSION} from mirror (one-time)…`);
  try {
    provisionElectronFromMirror(bundledDir);
    if (electronBinaryHealthy(bundledDir)) return;
    console.warn(`⚠️  Electron provisioned but health check still failing.`);
  } catch (e) {
    console.warn(`⚠️  Electron provision from mirror failed: ${e.message}`);
  }
}

// Resolve the electron binary to spawn. Order: (C) a shared GLOBAL electron,
// then the project-local copy, then `npx electron` as a last resort.
// Windows uses `npx.cmd electron` to handle the shim correctly.
function resolveElectronSpawn() {
  ensureElectron();
  const g = globalElectronBin();
  if (g) return { cmd: g, prefixArgs: [] };
  if (isWindows) return { cmd: "npx.cmd", prefixArgs: ["electron"] };
  const local = path.join(PACKAGE_ROOT, "node_modules", ".bin", "electron");
  if (fs.existsSync(local)) return { cmd: local, prefixArgs: [] };
  return { cmd: "npx", prefixArgs: ["electron"] };
}
const PROJECT_COMMAND_FILE = path.join(PACKAGE_ROOT, "cicy-dektop.command");
const DESKTOP_COMMAND_FILE = path.join(DESKTOP_DIR, "cicy-dektop.command");
const DEFAULT_MASTER_PORT = 8100;
const DEFAULT_WORKER_PORT = 8101;
const READY_TIMEOUT_MS = 15000;
const SHUTDOWN_TIMEOUT_MS = 5000;

const args = process.argv.slice(2);

let command = "start";
let useCNMirror = false;
let runUpdate = false;
let showVersion = false;
let masterPort = Number(process.env.MASTER_PORT || DEFAULT_MASTER_PORT);
let workerPort = Number(process.env.PORT || DEFAULT_WORKER_PORT);

for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === "-h" || arg === "--help") {
    showHelp();
    process.exit(0);
  } else if (arg === "-v" || arg === "--version") {
    showVersion = true;
  } else if (arg === "-j" || arg === "--json") {
    console.error("❌ --json is only supported by cicy-rpc");
    process.exit(1);
  } else if (arg === "-cn" || arg === "--cn") {
    useCNMirror = true;
  } else if (arg === "-u" || arg === "--update") {
    runUpdate = true;
  } else if (arg === "--master-port" && args[i + 1]) {
    masterPort = Number(args[++i]);
  } else if (arg.startsWith("--master-port=")) {
    masterPort = Number(arg.split("=")[1]);
  } else if (arg === "--port" && args[i + 1]) {
    workerPort = Number(args[++i]);
  } else if (arg.startsWith("--port=")) {
    workerPort = Number(arg.split("=")[1]);
  } else if (!arg.startsWith("-") && command === "start") {
    // First positional arg is the command; the rest are command args
    command = arg;
  }
}

if (!Number.isFinite(masterPort) || masterPort <= 0) {
  console.error("❌ Invalid --master-port value");
  process.exit(1);
}

if (!Number.isFinite(workerPort) || workerPort <= 0) {
  console.error("❌ Invalid --port value");
  process.exit(1);
}

if (showVersion) {
  console.log(`cicy version ${CLI_VERSION}`);
  process.exit(0);
}

if (useCNMirror) {
  try {
    execSync("npm config set registry https://registry.npmmirror.com", { stdio: "inherit" });
    console.log("📦 Using CN npm mirror: https://registry.npmmirror.com");
  } catch (err) {
    console.error("❌ Failed to set npm mirror:", err.message);
  }
}

if (runUpdate) {
  update();
} else {
  executeCommand(command);
}

function showHelp() {
  console.log(`cicy - CiCy Desktop Controller

Usage: cicy [command] [options]

Desktop commands:
  start                    Start cicy worker in foreground (default)
  stop                     Stop the running cicy worker
  status                   Show cicy worker status
  restart                  Restart the cicy worker
  logs                     Follow worker logs

Options:
  -h, --help               Show this help message
  -v, --version            Show version
  -cn                      Use CN npm mirror
  -u, --update             Update cicy to latest version
  --master-port <port>     Master port for cluster mode (default: 8100)
  --port <port>            Worker port for cluster mode (default: 8101)

Examples:
  cicy
  cicy status
  cicy restart
  cicy logs
  cicy --port 8201

RPC commands moved to: cicy-rpc`);
}

function update() {
  console.log("🔄 Updating cicy...");
  try {
    execSync("git pull", { cwd: PACKAGE_ROOT, stdio: "inherit" });
    execSync("npm install", { cwd: PACKAGE_ROOT, stdio: "inherit" });
    console.log("✅ cicy updated successfully");
  } catch (err) {
    console.error("❌ Update failed:", err.message);
    process.exit(1);
  }
}

function parsePid(value) {
  const pid = Number(value);
  return Number.isInteger(pid) && pid > 0 ? pid : null;
}

function findPidByPort(port) {
  try {
    const output = execSync(`lsof -tiTCP:${port} -sTCP:LISTEN`, {
      stdio: ["ignore", "pipe", "ignore"],
    })
      .toString()
      .trim()
      .split(/\r?\n/)
      .find(Boolean);
    return parsePid(output);
  } catch {
    return null;
  }
}

function readClusterState() {
  try {
    const raw = fs.readFileSync(STATE_FILE, "utf8");
    const state = JSON.parse(raw);
    return {
      masterPid: parsePid(state.masterPid),
      workerPid: parsePid(state.workerPid),
      masterPort: Number(state.masterPort) || DEFAULT_MASTER_PORT,
      workerPort: Number(state.workerPort) || DEFAULT_WORKER_PORT,
      tokenPath: state.tokenPath || null,
      startedAt: state.startedAt || null,
    };
  } catch {
    return null;
  }
}

function writeClusterState(state) {
  fs.writeFileSync(
    STATE_FILE,
    JSON.stringify(
      {
        ...state,
        updatedAt: new Date().toISOString(),
      },
      null,
      2
    )
  );
}

function clearClusterState() {
  if (fs.existsSync(STATE_FILE)) {
    fs.unlinkSync(STATE_FILE);
  }
}

function getRunningClusterState() {
  const state = readClusterState();
  const masterPortFromState = state?.masterPort || masterPort;
  const workerPortFromState = state?.workerPort || workerPort;
  const masterPid = state?.masterPid || findPidByPort(masterPortFromState);
  const workerPid = state?.workerPid || findPidByPort(workerPortFromState);
  const masterRunning = isRunning(masterPid);
  const workerRunning = isRunning(workerPid);

  if (!masterRunning && !workerRunning) {
    clearClusterState();
    return null;
  }

  const nextState = {
    masterPid: masterRunning ? masterPid : null,
    workerPid: workerRunning ? workerPid : null,
    masterPort: masterPortFromState,
    workerPort: workerPortFromState,
    tokenPath: state?.tokenPath || null,
    startedAt: state?.startedAt || null,
    masterRunning,
    workerRunning,
  };

  writeClusterState(nextState);
  return nextState;
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function stopPid(pid, label) {
  if (!pid || !isRunning(pid)) {
    return false;
  }

  try {
    process.kill(pid, "SIGTERM");
  } catch (error) {
    console.error(`❌ Failed to stop ${label}: ${error.message}`);
    return false;
  }

  for (let i = 0; i < 20; i++) {
    if (!isRunning(pid)) {
      return true;
    }
    await sleep(200);
  }

  try {
    process.kill(pid, "SIGKILL");
    return true;
  } catch (error) {
    console.error(`❌ Failed to force stop ${label}: ${error.message}`);
    return false;
  }
}

function killListenersByPort(port) {
  if (!Number.isFinite(port) || port <= 0) return;

  try {
    if (isWindows) {
      // Best-effort: kill LISTENING processes on the port
      execSync(
        `powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort ${port} -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess | Sort-Object -Unique | ForEach-Object { Stop-Process -Id $_ -Force }"`,
        { stdio: ["ignore", "ignore", "ignore"] }
      );
      return;
    }

    const pid = findPidByPort(port);
    if (pid) {
      try {
        process.kill(pid, "SIGKILL");
      } catch {}
    }
  } catch {}
}

function killAllElectronProcesses() {
  try {
    if (isWindows) {
      // electron.exe only (packaged Electron apps have different exe names)
      execSync("taskkill /F /T /IM electron.exe", { stdio: ["ignore", "ignore", "ignore"] });
      execSync("taskkill /F /T /IM Electron.exe", { stdio: ["ignore", "ignore", "ignore"] });
      return;
    }

    // macOS / Linux: kill common electron process names
    execSync("pkill -9 Electron", { stdio: ["ignore", "ignore", "ignore"] });
    execSync("pkill -9 electron", { stdio: ["ignore", "ignore", "ignore"] });
  } catch {}
}

function hardCleanupBeforeStart({ masterPort, workerPort }) {
  console.log("🧹 Cleaning up previous instance…");
  killListenersByPort(masterPort);
  killListenersByPort(workerPort);
  killAllElectronProcesses();
}

function startForegroundCluster() {
  hardCleanupBeforeStart({ masterPort, workerPort });
  ensureDesktopCommandFile();
  startWorkerOnly({ workerPort }).catch((error) => {
    console.error(`❌ Failed to start worker: ${error.message}`);
    process.exit(1);
  });
}

function executeCommand(cmd) {
  switch (cmd) {
    case "start":
      startForegroundCluster();
      break;
    case "stop":
      stop().catch((error) => {
        console.error(`❌ Failed to stop cicy worker: ${error.message}`);
        process.exit(1);
      });
      break;
    case "status":
      status().catch((error) => {
        console.error(`❌ Failed to get cicy worker status: ${error.message}`);
        process.exit(1);
      });
      break;
    case "restart":
      restart().catch((error) => {
        console.error(`❌ Failed to restart cicy worker: ${error.message}`);
        process.exit(1);
      });
      break;
    case "logs":
      logs();
      break;
    default:
      console.log(`Unknown command: ${cmd}`);
      console.log("Usage: cicy <start|stop|status|restart|logs>");
      process.exit(1);
  }
}

// Drop a double-clickable, CiCy-icon desktop shortcut that relaunches via
// `npx cicy-desktop`. GUI-launched shortcuts get a minimal PATH (no node), so
// we bake the dir of the node running this launcher (process.execPath) in.
function nodeBinDir() {
  try { return path.dirname(process.execPath); } catch { return ""; }
}

// npm's global bin dir (<npm prefix -g>[/bin]), where `npm i -g cicy-desktop`
// installs the launcher. The GUI shortcut runs that global bin directly so
// startup doesn't pay an npx registry round-trip on every launch.
function npmGlobalBinDir() {
  try {
    const prefix = execSync("npm prefix -g", { stdio: ["ignore", "pipe", "ignore"] })
      .toString().trim();
    return prefix ? (isWindows ? prefix : path.join(prefix, "bin")) : "";
  } catch { return ""; }
}

function ensureDesktopCommandFile() {
  try {
    if (process.platform === "darwin") return ensureMacDesktopApp();
    if (process.platform === "linux")  return ensureLinuxDesktopEntry();
    if (process.platform === "win32")  return ensureWindowsShortcut();
  } catch (e) {
    console.warn(`[shortcut] failed: ${e.message}`);
  }
}

function ensureMacDesktopApp() {
  // Build a REAL AppleScript .app via osacompile. A hand-crafted .app whose
  // executable is a shell script triggers "CiCy Desktop is not responding"
  // (LaunchServices waits for the script to register as a Cocoa app and times
  // out). An osacompile applet's executable IS the AppleScript runtime — a
  // proper Cocoa app — so it launches cleanly, backgrounds the global
  // `cicy-desktop` bin via `do shell script`, then quits. Icon = applet.icns.
  const { execFileSync } = require("child_process");
  const appDir = path.join(DESKTOP_DIR, "CiCy Desktop.app");
  // Idempotent — create only when missing. When the app is launched FROM this
  // very applet (double-click), the old code's fs.rmSync(appDir) tries to
  // delete the running bundle: the rmdir syscall blocks FOREVER (the app
  // deleting itself), so startup hangs at "Cleaning up ports" and no window
  // ever appears ("打不开"). Skip if it already exists.
  if (fs.existsSync(appDir)) return;
  const nodeDir = nodeBinDir();
  const gbin = npmGlobalBinDir();
  // Launch the globally-installed `cicy-desktop` bin DIRECTLY (npm i -g) — no
  // per-launch `npx` registry round-trip. Use the absolute path when resolvable
  // (GUI launch has a minimal PATH); fall back to the bare name otherwise.
  const cicyBin = gbin && fs.existsSync(path.join(gbin, "cicy-desktop"))
    ? path.join(gbin, "cicy-desktop")
    : "cicy-desktop";
  // do shell script needs node + the global bin on PATH (GUI launch has a
  // minimal PATH); trailing & + nohup + </dev/null lets the shell return so the
  // applet quits. ELECTRON_MIRROR + npmmirror only matter if electron ever
  // (re)downloads — harmless otherwise.
  const ascript =
    `do shell script "export PATH=\\"${nodeDir}:${gbin}:/usr/local/bin:/opt/homebrew/bin:$PATH\\" ; ` +
    `export ELECTRON_MIRROR=\\"${ELECTRON_MIRROR}\\" ; export npm_config_registry=\\"${NPM_REGISTRY}\\" ; ` +
    `nohup '${cicyBin}' > /tmp/cicy-desktop.log 2>&1 < /dev/null &"`;
  const tmp = path.join(os.tmpdir(), `cicy-launch-${process.pid}.applescript`);
  fs.writeFileSync(tmp, ascript);
  try {
    fs.rmSync(appDir, { recursive: true, force: true });
    execFileSync("osacompile", ["-o", appDir, tmp], { stdio: "ignore" });
    const icns = path.join(PACKAGE_ROOT, "build", "icon.icns");
    if (fs.existsSync(icns)) {
      fs.copyFileSync(icns, path.join(appDir, "Contents", "Resources", "applet.icns"));
    }
    try { const t = new Date(); fs.utimesSync(appDir, t, t); } catch {}
    console.log(`📎 Desktop shortcut: ${appDir}`);
  } finally {
    try { fs.unlinkSync(tmp); } catch {}
  }
}

function ensureLinuxDesktopEntry() {
  const icon = path.join(PACKAGE_ROOT, "build", "icons", "icon-256.png");
  const file = path.join(DESKTOP_DIR, "cicy-desktop.desktop");
  if (fs.existsSync(file)) return; // idempotent: create only when missing
  fs.mkdirSync(DESKTOP_DIR, { recursive: true });
  fs.writeFileSync(file,
`[Desktop Entry]
Type=Application
Name=CiCy Desktop
Exec=sh -c 'export PATH="${nodeBinDir()}:$PATH"; export ELECTRON_MIRROR="${ELECTRON_MIRROR}"; export npm_config_registry="${NPM_REGISTRY}"; exec npx -y cicy-desktop'
Icon=${icon}
Terminal=false
Categories=Development;
`);
  fs.chmodSync(file, 0o755);
  console.log(`📎 Desktop shortcut: ${file}`);
}

function ensureWindowsShortcut() {
  // A .cmd is icon-less; a proper .lnk with the CiCy icon is written via a
  // throwaway PowerShell script (WScript.Shell CreateShortcut + IconLocation).
  //
  // The shortcut runs the GLOBALLY-installed `cicy-desktop` bin, NOT
  // `npx cicy-desktop`. npx's libnpmexec lock false-positives as
  // "ECOMPROMISED / Lock compromised" on Windows boxes with realtime
  // antivirus (Defender touches node_modules mtimes mid-install → the lock
  // heartbeat aborts). `npm i -g` has no such lock, so Windows installs +
  // launches via the global bin (see README "Run via npx" / install one-liner).
  const ico = path.join(PACKAGE_ROOT, "build", "icon.ico");
  const lnk = path.join(DESKTOP_DIR, "CiCy Desktop.lnk");
  if (fs.existsSync(lnk)) return; // idempotent: create only when missing (also avoids re-popping 360 each launch)
  const nodeDir = nodeBinDir();
  const ps = path.join(require("os").tmpdir(), `cicy-shortcut-${process.pid}.ps1`);
  fs.writeFileSync(ps,
`$ws = New-Object -ComObject WScript.Shell
$s = $ws.CreateShortcut('${lnk.replace(/'/g, "''")}')
$s.TargetPath = 'cmd.exe'
$s.Arguments = '/c set PATH=${nodeDir};%APPDATA%\\npm;%PATH%&& cicy-desktop'
$s.IconLocation = '${ico.replace(/'/g, "''")}'
$s.Save()
`);
  try {
    execSync(`powershell -NoProfile -ExecutionPolicy Bypass -File "${ps}"`, { stdio: "ignore" });
    console.log(`📎 Desktop shortcut: ${lnk}`);
  } finally {
    try { fs.unlinkSync(ps); } catch {}
  }
}

function prefixLines(prefix, text) {
  return text
    .split(/\r?\n/)
    .filter(Boolean)
    .map((line) => `${prefix} ${line}`)
    .join("\n");
}

function pipeOutput(stream, prefix, onChunk) {
  if (!stream) return;
  stream.on("data", (chunk) => {
    const text = chunk.toString();
    const output = prefixLines(prefix, text);
    if (output) console.log(output);
    if (onChunk) onChunk(text);
  });
}

function waitForMasterReady(child, port) {
  return new Promise((resolve, reject) => {
    const expected = `[Master] listening on http://localhost:${port}`;
    let settled = false;

    const timer = setTimeout(() => {
      if (settled) return;
      settled = true;
      reject(new Error(`Master did not become ready within ${READY_TIMEOUT_MS}ms`));
    }, READY_TIMEOUT_MS);

    const finish = (error) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      if (error) reject(error);
      else resolve();
    };

    const onChunk = (text) => {
      if (text.includes(expected)) {
        finish();
      }
    };

    pipeOutput(child.stdout, "[master]", onChunk);
    pipeOutput(child.stderr, "[master]", onChunk);

    child.once("exit", (code, signal) => {
      finish(new Error(`Master exited before ready (code=${code}, signal=${signal})`));
    });
  });
}

function terminateChild(child, signal) {
  if (!child || child.exitCode !== null || child.killed) {
    return;
  }
  try {
    child.kill(signal);
  } catch {}
}

function waitForExit(child) {
  return new Promise((resolve) => {
    if (!child || child.exitCode !== null) {
      resolve();
      return;
    }
    child.once("exit", () => resolve());
  });
}

async function shutdownChildren(workerChild, masterChild) {
  terminateChild(workerChild, "SIGTERM");
  terminateChild(masterChild, "SIGTERM");

  await Promise.race([
    Promise.all([waitForExit(workerChild), waitForExit(masterChild)]),
    new Promise((resolve) => setTimeout(resolve, SHUTDOWN_TIMEOUT_MS)),
  ]);

  terminateChild(workerChild, "SIGKILL");
  terminateChild(masterChild, "SIGKILL");
}

async function fetchJson(url, options = {}) {
  const response = await fetch(url, options);
  const data = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(data.error || `Request failed: ${response.status}`);
  }
  return data;
}

async function checkMaster(masterBaseUrl) {
  try {
    await fetchJson(`${masterBaseUrl}/api/ping`);
    return true;
  } catch {
    return false;
  }
}

async function getWorkers(masterBaseUrl) {
  try {
    const data = await fetchJson(`${masterBaseUrl}/api/workers`);
    return data.workers || [];
  } catch {
    return [];
  }
}

async function findReusableWorker(masterBaseUrl, workerPort, timeoutMs = 8000) {
  const startedAt = Date.now();
  while (Date.now() - startedAt < timeoutMs) {
    const worker = selectWorker(await getWorkers(masterBaseUrl), workerPort);
    if (worker && (await checkWorker(worker))) {
      return worker;
    }
    await new Promise((resolve) => setTimeout(resolve, 1000));
  }
  return null;
}

function selectWorker(workers, workerPort) {
  const ranked = workers.filter((worker) => worker?.baseUrl);
  if (!ranked.length) return null;

  const exact = ranked.find(
    (worker) =>
      worker.baseUrl.endsWith(`:${workerPort}`) &&
      worker.registered &&
      (worker.status === "online" || worker.healthStatus === "online")
  );
  if (exact) return exact;

  const online = ranked.find(
    (worker) =>
      worker.registered && (worker.status === "online" || worker.healthStatus === "online")
  );
  return online || null;
}

async function checkWorker(worker) {
  if (!worker?.baseUrl) return false;
  try {
    await fetchJson(`${worker.baseUrl}/observability/healthz`);
    return true;
  } catch {
    return false;
  }
}

function resolveWorkerAuthToken(worker) {
  if (!worker?.baseUrl) return "";

  try {
    const config = JSON.parse(fs.readFileSync(GLOBAL_CONFIG_FILE, "utf8"));
    const nodes = Object.values(config.cicyDesktopNodes || {});
    const matchedNode = nodes.find((node) => node?.base_url === worker.baseUrl);
    return matchedNode?.api_token || config.api_token || "";
  } catch {
    return "";
  }
}

async function callWorkerTool(worker, toolName, payload = {}) {
  const authToken = resolveWorkerAuthToken(worker);
  if (!authToken) {
    throw new Error(`No auth token available for worker ${worker.workerId || worker.baseUrl}`);
  }

  return fetchJson(`${worker.baseUrl}/rpc/${toolName}`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${authToken}`,
    },
    body: JSON.stringify(payload),
  });
}

function parseToolText(response) {
  const text = response?.result?.content?.find((item) => item.type === "text")?.text;
  if (!text) return null;
  return text;
}

async function focusExistingWorker(worker, workerBaseUrl, workerUiUrl) {
  const windowsResponse = await callWorkerTool(worker, "get_windows", {});
  const text = parseToolText(windowsResponse);
  const windows = text ? JSON.parse(text) : [];
  const targetWindow =
    windows.find((win) => (win.url || "").startsWith(workerBaseUrl)) || windows[0] || null;

  if (targetWindow) {
    if (!String(targetWindow.url || "").startsWith(workerBaseUrl)) {
      await callWorkerTool(worker, "load_url", { win_id: targetWindow.id, url: workerUiUrl });
    }

    await callWorkerTool(worker, "control_electron_BrowserWindow", {
      win_id: targetWindow.id,
      code: "(() => { win.show(); if (win.isMinimized()) win.restore(); win.focus(); return true; })()",
    });
    return { reused: true, winId: targetWindow.id };
  }

  await callWorkerTool(worker, "open_window", {
    url: workerUiUrl,
    reuseWindow: true,
    accountIdx: 0,
  });
  return { reused: true, winId: null };
}

async function startWorker({ workerPort, masterBaseUrl, token, workerUiUrl }) {
  const electronSpawn = resolveElectronSpawn();
  const workerChild = spawn(
    electronSpawn.cmd,
    // Don't pass --url here. cicy-desktop now always opens the homepage
    // (https://desktop.cicy-ai.com/) as the first window. The cicy-code
    // console (workerUiUrl) is reachable from the homepage's local card,
    // not at startup — having both pop up was confusing.
    [...electronSpawn.prefixArgs, PACKAGE_ROOT, "--port", String(workerPort)],
    {
      cwd: PACKAGE_ROOT,
      shell: isWindows,
      env: {
        ...process.env,
        PORT: String(workerPort),
        CICY_MASTER_URL: masterBaseUrl,
        CICY_MASTER_TOKEN: token,
      },
      stdio: ["ignore", "pipe", "pipe"],
    }
  );

  pipeOutput(workerChild.stdout, "[worker]");
  pipeOutput(workerChild.stderr, "[worker]");
  return workerChild;
}

async function startWorkerOnly({ workerPort }) {
  const tokenManager = new MasterTokenManager();
  tokenManager.getToken(); // ensure the token file exists before the worker reads it

  writeClusterState({
    masterPid: null,
    workerPid: null,
    masterPort,
    workerPort,
    tokenPath: tokenManager.getConfigPath(),
    startedAt: new Date().toISOString(),
  });

  // The worker HTTP server on :PORT is skipped by default (see main.js —
  // httpEnabled=automationEnabled), so don't advertise http://localhost:PORT or
  // the /console/chrome UI: those URLs are dead unless CICY_DESKTOP_HTTP=1/--mcp.
  // Renderer RPC goes through electronRPC injected in preload, not this port.
  console.log("🚀 Starting CiCy Desktop…");
  console.log(`📄 Token file: ${tokenManager.getConfigPath()}`);
  console.log("🛑 Press Ctrl+C to stop processes started by this command");

  const electronSpawn = resolveElectronSpawn();
  const workerChild = spawn(
    electronSpawn.cmd,
    // Don't pass --url here. cicy-desktop now always opens the homepage
    // (https://desktop.cicy-ai.com/) as the first window. The cicy-code
    // console (workerUiUrl) is reachable from the homepage's local card,
    // not at startup — having both pop up was confusing.
    [...electronSpawn.prefixArgs, PACKAGE_ROOT, "--port", String(workerPort)],
    {
      cwd: PACKAGE_ROOT,
      shell: isWindows,
      env: {
        ...process.env,
        PORT: String(workerPort),
      },
      stdio: ["ignore", "pipe", "pipe"],
    }
  );

  pipeOutput(workerChild.stdout, "[worker]");
  pipeOutput(workerChild.stderr, "[worker]");

  writeClusterState({
    masterPid: null,
    workerPid: workerChild.pid,
    masterPort,
    workerPort,
    tokenPath: tokenManager.getConfigPath(),
    startedAt: new Date().toISOString(),
  });

  let shuttingDown = false;

  const handleShutdown = async (exitCode) => {
    if (shuttingDown) return;
    shuttingDown = true;
    await shutdownChildren(workerChild, null);
    clearClusterState();
    process.exit(exitCode);
  };

  process.on("SIGINT", () => {
    handleShutdown(0);
  });
  process.on("SIGTERM", () => {
    handleShutdown(0);
  });

  workerChild.once("exit", async (code, signal) => {
    if (shuttingDown) return;
    console.error(`❌ Worker exited (code=${code}, signal=${signal})`);
    await handleShutdown(code || 1);
  });
}

async function startMasterCluster({ masterPort, workerPort }) {
  const tokenManager = new MasterTokenManager();
  const token = tokenManager.getToken();
  const masterBaseUrl = `http://localhost:${masterPort}`;
  // Don't open the master UI by default; open the worker UI instead.
  const workerUiUrl = `http://localhost:${workerPort}/console/chrome?token=${token}`;

  writeClusterState({
    masterPid: null,
    workerPid: null,
    masterPort,
    workerPort,
    tokenPath: tokenManager.getConfigPath(),
    startedAt: new Date().toISOString(),
  });

  console.log(`🚀 Target master ${masterBaseUrl}`);
  console.log(`📄 Token file: ${tokenManager.getConfigPath()}`);

  const masterRunning = await checkMaster(masterBaseUrl);
  if (masterRunning) {
    const worker = await findReusableWorker(masterBaseUrl, workerPort);
    if (worker) {
      await focusExistingWorker(worker, `http://localhost:${workerPort}`, workerUiUrl);
      console.log("✅ Reused existing master and worker, focused Electron window");
      return;
    }
  }

  console.log("🛑 Press Ctrl+C to stop processes started by this command");

  let masterChild = null;
  if (!masterRunning) {
    console.log(`🚀 Starting master on ${masterBaseUrl}`);
    masterChild = spawn(process.execPath, [MASTER_ENTRY], {
      cwd: PACKAGE_ROOT,
      env: {
        ...process.env,
        MASTER_PORT: String(masterPort),
        CICY_MASTER_TOKEN: token,
      },
      stdio: ["ignore", "pipe", "pipe"],
    });

    writeClusterState({
      masterPid: masterChild.pid,
      workerPid: null,
      masterPort,
      workerPort,
      tokenPath: tokenManager.getConfigPath(),
      startedAt: new Date().toISOString(),
    });

    await waitForMasterReady(masterChild, masterPort);
  } else {
    console.log("♻️ Reusing existing master");
  }

  console.log(`🚀 Starting worker on http://localhost:${workerPort}`);
  const workerChild = await startWorker({ workerPort, masterBaseUrl, token, workerUiUrl });

  writeClusterState({
    masterPid: masterChild?.pid || null,
    workerPid: workerChild.pid,
    masterPort,
    workerPort,
    tokenPath: tokenManager.getConfigPath(),
    startedAt: new Date().toISOString(),
  });

  let shuttingDown = false;

  const handleShutdown = async (exitCode) => {
    if (shuttingDown) return;
    shuttingDown = true;
    await shutdownChildren(workerChild, masterChild);
    clearClusterState();
    process.exit(exitCode);
  };

  process.on("SIGINT", () => {
    handleShutdown(0);
  });
  process.on("SIGTERM", () => {
    handleShutdown(0);
  });

  if (masterChild) {
    masterChild.once("exit", async (code, signal) => {
      if (shuttingDown) return;
      console.error(`❌ Master exited (code=${code}, signal=${signal})`);
      await handleShutdown(code || 1);
    });
  }

  workerChild.once("exit", async (code, signal) => {
    if (shuttingDown) return;
    console.error(`❌ Worker exited (code=${code}, signal=${signal})`);
    await handleShutdown(code || 1);
  });
}

function isRunning(pid) {
  if (!pid) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function getClusterLogFiles(workerPort) {
  return [
    path.join(LOGS_DIR, `cicy-desktop-${workerPort}.log`),
    path.join(LOGS_DIR, `cicy-desktop-${DEFAULT_WORKER_PORT}.log`),
  ].filter((filePath, index, list) => list.indexOf(filePath) === index);
}

async function stop() {
  const state = getRunningClusterState();
  if (!state) {
    console.log("❌ cicy worker is not running");
    clearClusterState();
    return;
  }

  const stoppedWorker = await stopPid(state.workerPid, "worker");
  const stoppedMaster = await stopPid(state.masterPid, "master");
  clearClusterState();

  if (stoppedMaster || stoppedWorker) {
    console.log(`✅ cicy worker stopped (pid:${state.workerPid || "-"})`);
  } else {
    console.log("❌ cicy worker is not running");
  }
}

async function status() {
  const state = getRunningClusterState();
  if (!state) {
    console.log("❌ cicy worker is not running");
    return;
  }

  console.log("✅ cicy worker is running");
  console.log(
    `- worker pid: ${state.workerPid || "reused external"} (${state.workerRunning ? "running" : "stopped"})`
  );
  console.log(`- worker url: http://localhost:${state.workerPort}`);
  if (state.tokenPath) {
    console.log(`- token file: ${state.tokenPath}`);
  }
}

async function restart() {
  await stop();
  startForegroundCluster();
}

function logs() {
  const state = getRunningClusterState();
  const workerPortForLogs = state?.workerPort || workerPort;
  const logFiles = getClusterLogFiles(workerPortForLogs).filter((filePath) =>
    fs.existsSync(filePath)
  );

  if (!logFiles.length) {
    console.log("❌ No worker logs found");
    console.log(`- logs dir: ${LOGS_DIR}`);
    console.log(
      `- expected worker log: ${path.join(LOGS_DIR, `cicy-desktop-${workerPortForLogs}.log`)}`
    );
    return;
  }

  if (state) {
    console.log("✅ Following cicy worker logs");
    console.log(`- worker url: http://localhost:${state.workerPort}`);
  } else {
    console.log("⚠️  Worker is not currently running, showing latest available logs");
  }
  logFiles.forEach((filePath) => console.log(`- ${filePath}`));

  const quotedFiles = logFiles.map((filePath) => `"${filePath}"`).join(" ");
  execSync(`tail -f ${quotedFiles}`, { stdio: "inherit" });
}
