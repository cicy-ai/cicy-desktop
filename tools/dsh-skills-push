#!/usr/bin/env python3
"""dsh-skills-push — 把本机 cicy-code 的 skill(~/cicy-ai/skills)推到矩阵机,让 DeepSeek Harness(dsh)能用。

dsh 的 skill-filesystem 扫描 ~/.agents/skills/<name>/SKILL.md(和 ~/.dsh/skills),格式与 cicy-code 的
skill 完全一致,所以只要把目录复制过去就能在 dsh 里 /name 调用。目标机不需要装 cicy-code。

用法:
  dsh-skills-push <target|all> [--only a,b,c] [--restart] [--dry-run]
    target   wsd 的 target(xs-1002 / MHZFU / all,只处理 win32)
    --only   只推这些 skill(默认:~/cicy-ai/skills 根目录 + private/* + team/*/* 全部)
    --restart 推完重启目标机的 dsh(ctl stop/start),让 PATH 变化生效
    --linux <user@host>  Linux/WSL 目标:直接打印 rsync 命令(目标机有 ssh 即可)

做了什么(Windows 目标):
  1. 打包 skills(排除 *.zip/*.bak/agents.json/installed.json)→ base64 分块经 wsd 追加到目标机
  2. tar.exe 解压到 %USERPROFILE%\\.agents\\skills\\<name>\\
  3. 每个有 bin/<name> 的 skill 生成 %USERPROFILE%\\.agents\\bin\\<name>.cmd(用 cicy-node 的 node.exe 跑)
  4. 把 %USERPROFILE%\\.agents\\bin 加进用户 PATH(dsh 的 pwsh/bash 工具新进程可见)
注意:依赖 cicy-code 本地 API(127.0.0.1:8008)的 skill(cicy-agent/cicy-knowledge/…)在没装 cicy-code 的
机器上只有 SKILL.md 说明可用,bin 会连不上;纯工具型 skill(cicy-ssh/email/proxy_ssh/tg-login…)可直接用。
"""
import base64, io, json, os, subprocess, sys, tarfile, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
WSD = os.path.join(HERE, "wsd")
SKILLS_ROOT = os.path.expanduser(os.environ.get("CICY_SKILLS_ROOT", "~/cicy-ai/skills"))
CHUNK = 40000  # wsd 单次 main 的 out 有 60000 字符上限,请求体也别太大
EXCLUDE_EXT = (".zip", ".bak")
EXCLUDE_FILES = {"agents.json", "installed.json"}


def collect(only):
    """(name, abs_dir) 列表:根目录 skill + private/<n> + team/<t>/<n>。"""
    out = []
    def add(d):
        n = os.path.basename(d)
        if os.path.isfile(os.path.join(d, "SKILL.md")) and (not only or n in only):
            out.append((n, d))
    for e in sorted(os.listdir(SKILLS_ROOT)):
        p = os.path.join(SKILLS_ROOT, e)
        if not os.path.isdir(p):
            continue
        if e == "private":
            for s in sorted(os.listdir(p)):
                add(os.path.join(p, s))
        elif e == "team":
            for t in sorted(os.listdir(p)):
                for s in sorted(os.listdir(os.path.join(p, t))):
                    add(os.path.join(p, t, s))
        else:
            add(p)
    return out


def pack(items):
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for name, d in items:
            for root, dirs, files in os.walk(d):
                dirs[:] = [x for x in dirs if x != "node_modules"]
                for f in files:
                    if f.endswith(EXCLUDE_EXT) or f in EXCLUDE_FILES:
                        continue
                    full = os.path.join(root, f)
                    if os.path.islink(full):
                        full = os.path.realpath(full)
                    arc = os.path.join(name, os.path.relpath(os.path.join(root, f), d)).replace("\\", "/")
                    tf.add(full, arcname=arc)
    return buf.getvalue()


def wsd_main(target, js, timeout=130):
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(js); path = f.name
    try:
        r = subprocess.run([WSD, "main", target, path, "--json"], capture_output=True, text=True, timeout=timeout + 10)
    finally:
        os.unlink(path)
    try:
        d = json.loads(r.stdout)
    except Exception:
        raise SystemExit(f"wsd main {target} failed: {r.stdout[:300]} {r.stderr[:300]}")
    res = d["results"][0]
    if not res.get("ok"):
        raise SystemExit(f"{target}: {res.get('out')}")
    return res["out"]


JS_HEAD = "(async () => { const req = process.mainModule.require.bind(process.mainModule); const fs = req('fs'); const os = req('os'); const path = req('path'); const { execSync } = req('child_process'); const home = os.homedir(); const agents = path.join(home, '.agents'); const pack = path.join(agents, 'skills-push.tgz');"


def push(target, blob, bins, restart, dry):
    b64 = base64.b64encode(blob).decode()
    chunks = [b64[i:i + CHUNK] for i in range(0, len(b64), CHUNK)]
    print(f"[{target}] {len(blob)//1024}KB, {len(chunks)} chunks")
    if dry:
        return
    wsd_main(target, JS_HEAD + " fs.mkdirSync(path.join(agents,'skills'),{recursive:true}); fs.mkdirSync(path.join(agents,'bin'),{recursive:true}); try{fs.unlinkSync(pack+'.b64')}catch{}; return 'ok'; })()")
    for i, c in enumerate(chunks):
        wsd_main(target, JS_HEAD + f" fs.appendFileSync(pack+'.b64', {json.dumps(c)}); return String(fs.statSync(pack+'.b64').size); }})()")
        sys.stdout.write(f"\r[{target}] sent {i+1}/{len(chunks)}"); sys.stdout.flush()
    print()
    shims = json.dumps(bins)
    js = JS_HEAD + f"""
      const b64 = fs.readFileSync(pack+'.b64','utf8'); fs.writeFileSync(pack, Buffer.from(b64,'base64')); fs.unlinkSync(pack+'.b64');
      const skills = path.join(agents,'skills');
      const tar = path.join(process.env.SystemRoot||'C:\\\\Windows','System32','tar.exe');
      execSync('"'+tar+'" -xzf "'+pack+'" -C "'+skills+'"', {{timeout:120000, windowsHide:true}});
      fs.unlinkSync(pack);
      // shims: .agents\\bin\\<name>.cmd -> node bin/<name>
      const la = process.env.LOCALAPPDATA; const cands=[path.join(la,'cicy-node','node.exe'),'C:\\\\Program Files\\\\nodejs\\\\node.exe'];
      const node = cands.find(p=>fs.existsSync(p)) || 'node';
      const bins = {shims}; const made=[];
      for (const n of bins) {{ const b = path.join(skills, n, 'bin', n); if (!fs.existsSync(b)) continue;
        fs.writeFileSync(path.join(agents,'bin',n+'.cmd'), '@echo off\\r\\n"'+node+'" "'+b+'" %*\\r\\n'); made.push(n); }}
      // user PATH += .agents\\bin (HKCU, 不动系统 PATH)
      let pathMsg='';
      try {{ const ps = "$d=[Environment]::ExpandEnvironmentVariables('%USERPROFILE%\\\\.agents\\\\bin'); $p=[Environment]::GetEnvironmentVariable('Path','User'); if(-not $p){{$p=''}}; if(($p -split ';') -notcontains $d){{ [Environment]::SetEnvironmentVariable('Path', ($p.TrimEnd(';')+';'+$d).TrimStart(';'), 'User'); 'added' }} else {{ 'present' }}";
        pathMsg = execSync('powershell -NoProfile -Command "'+ps.replace(/"/g,'\\\\"')+'"', {{encoding:'utf8', timeout:30000, windowsHide:true}}).trim(); }} catch (e) {{ pathMsg = 'ERR ' + String(e.message).slice(0,80); }}
      const names = fs.readdirSync(skills).filter(n=>fs.existsSync(path.join(skills,n,'SKILL.md')));
      return JSON.stringify({{skills: names.length, list: names, shims: made, userPath: pathMsg}});
    }})()"""
    print(f"[{target}] " + wsd_main(target, js))
    if restart:
        js = JS_HEAD + """ const la=process.env.LOCALAPPDATA; const node=path.join(la,'cicy-node','node.exe'), npm=path.join(la,'cicy-node','npm.cmd'), ctl=path.join(home,'cicy-ai','db','dsh-ctl.js');
          if(!fs.existsSync(node)||!fs.existsSync(ctl)) return 'no dsh ctl on this machine';
          const run=(op)=>{ try { return execSync('"'+node+'" "'+ctl+'" '+op+' "'+npm+'"',{encoding:'utf8',timeout:150000,windowsHide:true}).trim().slice(-160);} catch(e){ return 'ERR '+String(e.message).slice(0,100);} };
          run('stop'); return 'restart: '+run('start'); })()"""
        print(f"[{target}] " + wsd_main(target, js, timeout=160))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    only = None; restart = False; dry = False; linux = None; target = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--only": only = set(argv[i + 1].split(",")); i += 1
        elif a == "--restart": restart = True
        elif a == "--dry-run": dry = True
        elif a == "--linux": linux = argv[i + 1]; i += 1
        else: target = a
        i += 1
    items = collect(only)
    if not items:
        raise SystemExit("no skills found under " + SKILLS_ROOT)
    print("skills:", " ".join(n for n, _ in items))
    if linux:
        srcs = " ".join(f'"{d}"' for _, d in items)
        print("\nLinux/WSL 目标(目标机有 ssh 即可,不需要 cicy-code):")
        print(f"  ssh {linux} 'mkdir -p ~/.agents/skills ~/.agents/bin'")
        print(f"  rsync -a --exclude '*.zip' --exclude '*.bak' {srcs} {linux}:~/.agents/skills/")
        print(f"  ssh {linux} 'for b in ~/.agents/skills/*/bin/*; do ln -sf \"$b\" ~/.agents/bin/; done; grep -q .agents/bin ~/.bashrc || echo \"export PATH=\\$HOME/.agents/bin:\\$PATH\" >> ~/.bashrc'")
        print("  然后重启 dsh。需要 cicy-code API 的 skill 再加:ssh -N -L 8008:127.0.0.1:8008 <cicy-code 主机>,并 export CICY_API_TOKEN=…")
        return 0
    if not target:
        raise SystemExit("need <target|all> (see --help)")
    blob = pack(items)
    bins = [n for n, d in items if os.path.isfile(os.path.join(d, "bin", n))]
    if target == "all":
        r = subprocess.run([WSD, "nodes"], capture_output=True, text=True)
        targets = sorted({l.split()[0].replace("desktop-", "") for l in r.stdout.splitlines() if "win32" in l})
    else:
        targets = [target]
    for t in targets:
        try:
            push(t, blob, bins, restart, dry)
        except SystemExit as e:
            print(f"[{t}] FAILED: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
