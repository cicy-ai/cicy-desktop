#!/usr/bin/env python3
"""dsh-task — 给矩阵机上的 DeepSeek Harness(dsh)下任务、查会话、看它干了什么。

原理:dsh 的 headless profile 一次性跑一个任务(`dsh --profile headless "<task>"`),最终答案打到 stdout、
退出码 0/1;会话照样持久化到 ~/.dsh/sessions/<cwd>/session-<id>/session.jsonl.zstd,所以 harness 网页的
对应工作区里也能看到这条会话。本工具经 wsd 在目标机上后台起 dsh(带 hub 下发的 API Key),轮询拿结果。

用法:
  dsh-task <machine|all> run "<任务>" [--cwd ~] [--timeout 900] [--no-wait]
  dsh-task <machine> tasks                     # 本工具起过的任务(状态/退出码/答案摘要)
  dsh-task <machine> result <task-id>          # 某次任务的完整 stdout / stderr(推理)
  dsh-task <machine> sessions [--cwd ~] [-n 10]   # 该工作区最近的会话(标题/结束原因/最后回复)
  dsh-task <machine> show <session-id>         # 回放一条会话:用户消息、工具调用、助手回复

--cwd 默认 ~(即 hub 下发的默认工作区 C:\\Users\\xs);支持 ~ 和 %VAR%。
"""
import json, os, subprocess, sys, tempfile, time

HERE = os.path.dirname(os.path.abspath(__file__))
WSD = os.path.join(HERE, "wsd")

JS_HEAD = r"""(async () => { const req = process.mainModule.require.bind(process.mainModule); const fs = req('fs'); const os = req('os'); const path = req('path'); const zlib = req('zlib'); const { spawn } = req('child_process');
  const home = os.homedir(), la = process.env.LOCALAPPDATA || '';
  const node = path.join(la, 'cicy-node', 'node.exe'), bin = path.join(la, 'cicy-node', 'node_modules', '@deepseek-ai', 'dsh', 'lib', 'bin.js');
  const logDir = path.join(home, 'cicy-ai', 'logs'), sessRoot = path.join(home, '.dsh', 'sessions');
  const expand = (p) => { let s = String(p || '~').trim(); if (s === '~' || s.startsWith('~/') || s.startsWith('~\\')) s = home + s.slice(1); s = s.replace(/%([A-Za-z_][A-Za-z0-9_]*)%/g, (m, k) => process.env[k] || m); return path.resolve(s); };
  const fleetEnv = () => { try { return JSON.parse(fs.readFileSync(path.join(home, 'cicy-ai', 'db', 'dsh-env.json'), 'utf8')).env || {}; } catch { return {}; } };
  const rd = (f) => { try { return fs.readFileSync(f, 'utf8'); } catch { return null; } };
  // session.jsonl.zstd = 多个 zstd frame 首尾相接;Node 的 zstdDecompressSync 只解第一个 frame,按 magic 拆开逐个解
  const decode = (f) => { const buf = fs.readFileSync(f); const magic = Buffer.from([0x28, 0xb5, 0x2f, 0xfd]); const st = []; let i = 0; while ((i = buf.indexOf(magic, i)) !== -1) { st.push(i); i += 4; } let out = ''; for (let k = 0; k < st.length; k++) { try { out += zlib.zstdDecompressSync(buf.subarray(st[k], k + 1 < st.length ? st[k + 1] : buf.length)).toString('utf8'); } catch {} } return out.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean); };
  const textOf = (msg) => ((msg && msg.content) || []).filter((c) => c.type === 'text').map((c) => c.text).join('\n');
  const sessionsOf = (cwd) => { const out = []; let dirs = []; try { dirs = fs.readdirSync(sessRoot); } catch { return out; }
    for (const d of dirs) { const dp = path.join(sessRoot, d); let ss = []; try { ss = fs.readdirSync(dp); } catch { continue; }
      for (const s of ss) { const f = path.join(dp, s, 'session.jsonl.zstd'); let st; try { st = fs.statSync(f); } catch { continue; } out.push({ id: s, file: f, mtime: st.mtimeMs, size: st.size, dir: d }); } }
    return out.sort((a, b) => b.mtime - a.mtime); };
  const summarize = (ev) => { const head = ev.find((e) => e.type === 'session') || {}; let title = '', last = '', reason = '', tools = 0, turns = 0, users = 0;
    for (const e of ev) { if (e.type === 'session/title') title = e.data.title; else if (e.type === 'assistant/message') { const t = textOf(e.data.message); if (t) last = t; } else if (e.type === 'turn/end') { turns++; reason = e.data.reason && e.data.reason.kind; } else if (e.type === 'user/message' && e.data.source && e.data.source.kind === 'user') users++; else if (/^tool\/(call|start|use)/.test(e.type) || (e.type === 'assistant/chunk' && e.data.chunk && e.data.chunk.type === 'tool-call')) tools++; }
    return { id: head.id, cwd: head.cwd, createdAt: head.createdAt, title, turns, users, tools, reason, last: last.slice(0, 300) }; };
"""


def wsd_main(target, js, timeout=120):
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(js); p = f.name
    try:
        r = subprocess.run([WSD, "main", target, p, "--json"], capture_output=True, text=True, timeout=timeout + 15)
    finally:
        os.unlink(p)
    try:
        res = json.loads(r.stdout)["results"][0]
    except Exception:
        raise SystemExit(f"wsd main {target}: {r.stdout[:200]} {r.stderr[:200]}")
    if not res.get("ok"):
        raise SystemExit(f"{target}: {res.get('out')}")
    return res["out"]


def start_task(target, task, cwd):
    js = JS_HEAD + f"""
  const TASK = {json.dumps(task)}; const CWD = expand({json.dumps(cwd)});
  if (!fs.existsSync(node) || !fs.existsSync(bin)) return JSON.stringify({{ error: 'dsh not installed (no cicy-node/dsh)' }});
  try {{ fs.mkdirSync(CWD, {{ recursive: true }}); fs.mkdirSync(logDir, {{ recursive: true }}); }} catch {{}}
  const id = 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 5);
  const base = path.join(logDir, 'dsh-task-' + id);
  fs.writeFileSync(base + '.meta', JSON.stringify({{ id, task: TASK, cwd: CWD, startedAt: Date.now() }}));
  const out = fs.openSync(base + '.out', 'w'), err = fs.openSync(base + '.err', 'w');
  const child = spawn(node, [bin, '--profile', 'headless', TASK], {{ cwd: CWD, detached: true, windowsHide: true, stdio: ['ignore', out, err], env: Object.assign({{}}, process.env, {{ NO_COLOR: '1', PATH: path.dirname(node) + path.delimiter + process.env.PATH }}, fleetEnv()) }});
  child.on('exit', (c) => {{ try {{ fs.writeFileSync(base + '.code', String(c)); }} catch {{}} }});
  child.on('error', (e) => {{ try {{ fs.writeFileSync(base + '.err', 'spawn error: ' + e.message); fs.writeFileSync(base + '.code', '1'); }} catch {{}} }});
  child.unref(); try {{ fs.closeSync(out); fs.closeSync(err); }} catch {{}}
  return JSON.stringify({{ id, pid: child.pid, cwd: CWD, env: Object.keys(fleetEnv()) }});
}})()"""
    return json.loads(wsd_main(target, js))


def poll_task(target, tid):
    js = JS_HEAD + f"""
  const base = path.join(logDir, 'dsh-task-' + {json.dumps(tid)});
  const meta = JSON.parse(rd(base + '.meta') || '{{}}'); const code = rd(base + '.code');
  let session = null;
  if (code !== null) {{ const s = sessionsOf().find((x) => x.mtime >= (meta.startedAt || 0) - 2000 && (() => {{ try {{ return (decode(x.file)[0] || {{}}).cwd === meta.cwd; }} catch {{ return false; }} }})()); if (s) session = s.id; }}
  return JSON.stringify({{ code, out: rd(base + '.out'), err: (rd(base + '.err') || '').slice(-4000), meta, session }});
}})()"""
    return json.loads(wsd_main(target, js))


def list_tasks(target):
    js = JS_HEAD + r"""
  let files = []; try { files = fs.readdirSync(logDir).filter((f) => /^dsh-task-.*\.meta$/.test(f)); } catch {}
  const rows = files.map((f) => { const meta = JSON.parse(rd(path.join(logDir, f)) || '{}'); const base = path.join(logDir, f.replace(/\.meta$/, '')); const code = rd(base + '.code'); const out = (rd(base + '.out') || '').trim(); return { id: meta.id, startedAt: meta.startedAt, cwd: meta.cwd, task: String(meta.task || '').slice(0, 80), status: code === null ? 'running' : (code === '0' ? 'done' : 'failed(' + code + ')'), answer: out.slice(-200) }; });
  return JSON.stringify(rows.sort((a, b) => b.startedAt - a.startedAt).slice(0, 30));
})()"""
    return json.loads(wsd_main(target, js))


def list_sessions(target, cwd, n):
    js = JS_HEAD + f"""
  const CWD = expand({json.dumps(cwd)}); const rows = [];
  for (const s of sessionsOf()) {{ if (rows.length >= {int(n)}) break; let ev; try {{ ev = decode(s.file); }} catch {{ continue; }} const sum = summarize(ev); if (sum.cwd && sum.cwd.toLowerCase() !== CWD.toLowerCase()) continue; rows.push(Object.assign(sum, {{ mtime: s.mtime, size: s.size }})); }}
  return JSON.stringify({{ cwd: CWD, rows }});
}})()"""
    return json.loads(wsd_main(target, js))


def show_session(target, sid):
    js = JS_HEAD + f"""
  const s = sessionsOf().find((x) => x.id === {json.dumps(sid)} || x.id === 'session-' + {json.dumps(sid)});
  if (!s) return JSON.stringify({{ error: 'session not found' }});
  const ev = decode(s.file); const lines = []; const sum = summarize(ev);
  for (const e of ev) {{
    if (e.type === 'user/message' && e.data.source && e.data.source.kind === 'user') lines.push({{ t: e.time, k: 'USER', text: textOf(e.data) }});
    else if (e.type === 'assistant/message') {{ const m = e.data.message; const txt = textOf(m); if (txt) lines.push({{ t: e.time, k: 'ASSISTANT', text: txt }}); for (const c of (m.content || [])) {{ if (c.type === 'tool-call' || c.type === 'tool_use' || c.type === 'toolCall') lines.push({{ t: e.time, k: 'TOOL-CALL', text: (c.name || c.toolName || '?') + ' ' + JSON.stringify(c.input || c.args || c.arguments || {{}}).slice(0, 400) }}); }} }}
    else if (e.type.startsWith('tool/')) lines.push({{ t: e.time, k: e.type.toUpperCase(), text: JSON.stringify(e.data).slice(0, 400) }});
    else if (e.type === 'turn/end') lines.push({{ t: e.time, k: 'TURN-END', text: JSON.stringify(e.data.reason) }});
  }}
  const kinds = {{}}; for (const e of ev) kinds[e.type] = (kinds[e.type] || 0) + 1;
  return JSON.stringify({{ sum, lines, kinds }});
}})()"""
    return json.loads(wsd_main(target, js))


def targets_of(t):
    if t != "all":
        return [t]
    r = subprocess.run([WSD, "nodes"], capture_output=True, text=True)
    return sorted({l.split()[0].replace("desktop-", "") for l in r.stdout.splitlines() if "win32" in l})


def fmt_ts(ms):
    return time.strftime("%m-%d %H:%M:%S", time.localtime((ms or 0) / 1000))


def main(argv):
    if len(argv) < 2 or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    target, cmd, rest = argv[0], argv[1], argv[2:]
    cwd = "~"; timeout = 900; wait = True; n = 10; pos = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--cwd": cwd = rest[i + 1]; i += 1
        elif a == "--timeout": timeout = int(rest[i + 1]); i += 1
        elif a == "-n": n = int(rest[i + 1]); i += 1
        elif a == "--no-wait": wait = False
        else: pos.append(a)
        i += 1
    if cmd == "run":
        if not pos: raise SystemExit("run needs a task text")
        task = " ".join(pos)
        started = {}
        for t in targets_of(target):
            try:
                r = start_task(t, task, cwd)
                if r.get("error"): print(f"[{t}] {r['error']}"); continue
                started[t] = r["id"]; print(f"[{t}] started task {r['id']} (cwd {r['cwd']}, env {r['env']})")
            except SystemExit as e: print(f"[{t}] FAILED: {e}")
        if not wait: return 0
        deadline = time.time() + timeout; pending = dict(started)
        while pending and time.time() < deadline:
            time.sleep(8)
            for t, tid in list(pending.items()):
                try: r = poll_task(t, tid)
                except SystemExit as e: print(f"[{t}] poll failed: {e}"); continue
                if r["code"] is None: continue
                del pending[t]
                ok = r["code"] == "0"
                print(f"\n===== [{t}] task {tid} {'DONE' if ok else 'FAILED exit=' + str(r['code'])} · session {r.get('session') or '?'}")
                print((r["out"] or "").rstrip() or "(no stdout)")
                if not ok or "dsh:" in (r["err"] or ""):
                    print("--- stderr tail ---"); print((r["err"] or "").rstrip()[-1500:])
        for t, tid in pending.items(): print(f"[{t}] task {tid} still running after {timeout}s — check later: dsh-task {t} result {tid}")
        return 0
    if cmd == "tasks":
        for r in list_tasks(target): print(f"{r['id']}  {fmt_ts(r['startedAt'])}  {r['status']:<10} {r['task']}\n      → {r['answer'].replace(chr(10), ' / ')}")
        return 0
    if cmd == "result":
        r = poll_task(target, pos[0]); print(f"status: {'running' if r['code'] is None else 'exit ' + r['code']} · task: {r['meta'].get('task')} · cwd: {r['meta'].get('cwd')} · session: {r.get('session')}\n--- stdout ---\n{r['out']}\n--- stderr (reasoning/errors) ---\n{r['err']}")
        return 0
    if cmd == "sessions":
        r = list_sessions(target, cwd, n); print(f"workspace {r['cwd']} — {len(r['rows'])} sessions")
        for s in r["rows"]: print(f"{s['id']}  {fmt_ts(s['createdAt'])}  turns={s['turns']} tools={s['tools']} end={s['reason'] or '-'}  「{s['title']}」\n      → {s['last'].replace(chr(10), ' / ')[:200]}")
        return 0
    if cmd == "show":
        r = show_session(target, pos[0])
        if r.get("error"): raise SystemExit(r["error"])
        s = r["sum"]; print(f"{s['id']}  cwd={s['cwd']}  created={fmt_ts(s['createdAt'])}  turns={s['turns']} tools={s['tools']} end={s['reason']}  「{s['title']}」")
        for l in r["lines"]: print(f"\n[{fmt_ts(l['t'])}] {l['k']}\n{l['text']}")
        print("\nevent kinds:", json.dumps(r["kinds"], ensure_ascii=False))
        return 0
    raise SystemExit("unknown command: " + cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
