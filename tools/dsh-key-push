#!/usr/bin/env python3
"""dsh-key-push — 把 DeepSeek API Key 统一写到矩阵机的 DeepSeek Harness(dsh)凭据文件里。

dsh 的 key 存在每台机器的 %USERPROFILE%\\.dsh\\.credentials.yaml:
    refs:
      DEEPSEEK_API_KEY: sk-…
(界面"保存并继续"写的就是这一行。)dsh 监视这个文件,改完立即生效,不用重启。
优先级:启动环境变量 > 这个文件 > <cwd>/.env > ~/.dsh/.env。
文件里的 records.client-connection/* 是每台机器自己的浏览器会话 grant,本工具不碰。

推荐(长远方式):写到 hub 的车队配置,hub 经 fleet ws 下发给每台已验证的机器,DshCard 落盘
~/cicy-ai/db/dsh-env.json 并把它作为 dsh 的启动环境(优先级最高、界面只读),新机器上线自动带上:
  dsh-key-push --hub --key sk-xxx                 # 写 ~/cicy-ai/db/dsh-fleet.json,hub 立即推送
  dsh-key-push --hub --from xs-3002               # 从某台已配好的机器读 key 再写到 hub
  dsh-key-push --hub --status                     # 看 hub 当前配置(掩码)和已推送机器数
  dsh-key-push --hub --unset                      # 清空(机器上 dsh 重启后回到本地 key)

逐机直写凭据文件(临时/兜底方式):
  dsh-key-push <target|all> --key sk-xxx          # 直接给 key
  dsh-key-push <target|all> --from xs-3002        # 从某台已配好的机器读出来再分发
  dsh-key-push <target|all> --file ~/cicy-ai/db/dsh.json   # {"DEEPSEEK_API_KEY": "sk-…"}
  dsh-key-push <target|all> --unset               # 删掉 key(回到未配置状态)
  dsh-key-push <target|all> --status              # 只看每台有没有配(不显示值)
  加 --env 同时写 ~/.dsh/.env(DEEPSEEK_API_KEY=…),作为文件被界面改掉后的兜底。
"""
import json, os, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
WSD = os.path.join(HERE, "wsd")

JS_HEAD = r"""(async () => { const req = process.mainModule.require.bind(process.mainModule); const fs = req('fs'); const os = req('os'); const path = req('path');
  const home = os.homedir(); const dsh = path.join(home, '.dsh'); const cred = path.join(dsh, '.credentials.yaml'); const envf = path.join(dsh, '.env');
  const read = () => { try { return fs.readFileSync(cred, 'utf8'); } catch { return ''; } };
  const keyOf = (t) => { const m = t.match(/^refs:\s*\n((?:[ \t]+[^\n]*\n?)*)/m); if (!m) return ''; const k = m[1].match(/^[ \t]+DEEPSEEK_API_KEY:[ \t]*(.+?)[ \t]*$/m); return k ? k[1].replace(/^['"]|['"]$/g, '') : ''; };
  const mask = (k) => k ? k.slice(0, 5) + '…' + k.slice(-3) + '(' + k.length + ')' : '';
"""


def wsd_main(target, js, timeout=60):
    with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
        f.write(js); p = f.name
    try:
        r = subprocess.run([WSD, "main", target, p, "--json"], capture_output=True, text=True, timeout=timeout + 10)
    finally:
        os.unlink(p)
    try:
        res = json.loads(r.stdout)["results"][0]
    except Exception:
        raise SystemExit(f"wsd main {target}: {r.stdout[:200]} {r.stderr[:200]}")
    if not res.get("ok"):
        raise SystemExit(f"{target}: {res.get('out')}")
    return res["out"]


def status(target):
    return wsd_main(target, JS_HEAD + " const t = read(); let env=''; try { env = (fs.readFileSync(envf,'utf8').match(/^DEEPSEEK_API_KEY=(.*)$/m)||[])[1]||''; } catch {} let fleet=null; try { const j = JSON.parse(fs.readFileSync(path.join(home,'cicy-ai','db','dsh-env.json'),'utf8')); fleet = { rev: j.rev, keys: Object.keys(j.env||{}) }; } catch {} let applied=''; try { applied = fs.readFileSync(path.join(home,'cicy-ai','db','dsh-env.applied'),'utf8').trim(); } catch {} return JSON.stringify({ file: !!t, key: mask(keyOf(t)), env: mask(env.trim()), fleet, applied }); })()")


def read_key(target):
    out = wsd_main(target, JS_HEAD + " return keyOf(read()); })()")
    if not out:
        raise SystemExit(f"{target}: no DEEPSEEK_API_KEY in its .credentials.yaml")
    return out


def write_key(target, key, also_env):
    js = JS_HEAD + f"""
  const KEY = {json.dumps(key)}; const ALSO_ENV = {json.dumps(bool(also_env))};
  fs.mkdirSync(dsh, {{ recursive: true }});
  let t = read(); const before = keyOf(t);
  if (!t.trim()) t = 'version: 1\\n';
  if (!/^refs:/m.test(t)) {{ t = t.replace(/\\s*$/, '\\n') + 'refs:\\n  DEEPSEEK_API_KEY: ' + KEY + '\\n'; }}
  else if (/^[ \\t]+DEEPSEEK_API_KEY:/m.test(t)) {{ t = t.replace(/^([ \\t]+)DEEPSEEK_API_KEY:[^\\n]*$/m, '$1DEEPSEEK_API_KEY: ' + KEY); }}
  else {{ t = t.replace(/^refs:[ \\t]*\\n/m, 'refs:\\n  DEEPSEEK_API_KEY: ' + KEY + '\\n'); }}
  fs.writeFileSync(cred, t, {{ mode: 0o600 }});
  let envMsg = 'skip';
  if (ALSO_ENV) {{ let e = ''; try {{ e = fs.readFileSync(envf, 'utf8'); }} catch {{}}
    e = /^DEEPSEEK_API_KEY=/m.test(e) ? e.replace(/^DEEPSEEK_API_KEY=.*$/m, 'DEEPSEEK_API_KEY=' + KEY) : e.replace(/\\s*$/, e ? '\\n' : '') + 'DEEPSEEK_API_KEY=' + KEY + '\\n';
    fs.writeFileSync(envf, e, {{ mode: 0o600 }}); envMsg = 'written'; }}
  return JSON.stringify({{ before: mask(before), after: mask(keyOf(read())), env: envMsg }});
}})()"""
    return wsd_main(target, js)


def unset_key(target):
    js = JS_HEAD + r""" let t = read(); const before = keyOf(t);
  t = t.replace(/^[ \t]+DEEPSEEK_API_KEY:[^\n]*\n?/m, ''); t = t.replace(/^refs:[ \t]*\n(?![ \t])/m, '');
  fs.writeFileSync(cred, t, { mode: 0o600 });
  try { let e = fs.readFileSync(envf, 'utf8'); e = e.replace(/^DEEPSEEK_API_KEY=.*\n?/m, ''); fs.writeFileSync(envf, e); } catch {}
  return JSON.stringify({ before: mask(before), after: mask(keyOf(read())) }); })()"""
    return wsd_main(target, js)


HUB_CFG = os.path.expanduser("~/cicy-ai/db/dsh-fleet.json")
HUB_URL = os.environ.get("CICY_FLEET_HUB", "http://127.0.0.1:8799")


def hub_token():
    try:
        with open(os.path.expanduser("~/cicy-ai/db/desktop-ctrl.json")) as f: return json.load(f)["token"]
    except Exception: return ""


def hub_mode(mode, key):
    import urllib.request
    tok = hub_token()
    if mode == "status":
        req = urllib.request.Request(HUB_URL + "/api/dsh-config", headers={"x-cicy-ctrl": tok})
        print(urllib.request.urlopen(req, timeout=10).read().decode()); return
    env = {} if mode == "unset" else {"DEEPSEEK_API_KEY": key}
    if mode == "set" and not key:
        raise SystemExit("need --key / --file")
    body = json.dumps({"env": env}).encode()
    req = urllib.request.Request(HUB_URL + "/api/dsh-config", data=body, method="PUT", headers={"x-cicy-ctrl": tok, "content-type": "application/json"})
    print(urllib.request.urlopen(req, timeout=10).read().decode())


def targets_of(t):
    if t != "all":
        return [t]
    r = subprocess.run([WSD, "nodes"], capture_output=True, text=True)
    return sorted({l.split()[0].replace("desktop-", "") for l in r.stdout.splitlines() if "win32" in l})


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0
    target = None; key = None; src = None; also_env = False; mode = "set"; hub = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--hub": hub = True
        elif a == "--key": key = argv[i + 1]; i += 1
        elif a == "--from": src = argv[i + 1]; i += 1
        elif a == "--file":
            with open(os.path.expanduser(argv[i + 1])) as f: key = json.load(f)["DEEPSEEK_API_KEY"]
            i += 1
        elif a == "--env": also_env = True
        elif a == "--unset": mode = "unset"
        elif a == "--status": mode = "status"
        else: target = a
        i += 1
    if hub:
        if mode == "set" and src and not key:
            key = read_key(src); print(f"key from {src}: {key[:5]}…{key[-3:]} ({len(key)} chars)")
        hub_mode(mode, key); return 0
    if not target:
        raise SystemExit("need <target|all> (see --help)")
    if mode == "set":
        if src and not key:
            key = read_key(src); print(f"key from {src}: {key[:5]}…{key[-3:]} ({len(key)} chars)")
        if not key:
            raise SystemExit("need --key / --from / --file")
    for t in targets_of(target):
        try:
            if mode == "status": print(f"[{t}] {status(t)}")
            elif mode == "unset": print(f"[{t}] unset {unset_key(t)}")
            else: print(f"[{t}] {write_key(t, key, also_env)}")
        except SystemExit as e:
            print(f"[{t}] FAILED: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
