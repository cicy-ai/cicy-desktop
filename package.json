{
  "name": "cicy-desktop",
  "version": "2.1.213",
  "description": "CiCy - AI-powered operating system browser",
  "main": "src/main.js",
  "bin": {
    "cicy-desktop": "./bin/cicy-desktop",
    "cicy": "./bin/cicy-desktop",
    "cicy-rpc": "./bin/cicy-rpc"
  },
  "scripts": {
    "start": "node ./bin/cicy-desktop",
    "start:master": "node src/master/master-main.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest",
    "test:ls": "node tests/test-ls.js",
    "build": "electron-builder --publish never",
    "build:ui": "cd packages/ui-react && npm install && npm run build",
    "build:homepage": "node scripts/build-homepage.cjs",
    "prebuild:win": "node scripts/build-homepage.cjs",
    "prebuild:mac": "node scripts/build-homepage.cjs",
    "prebuild:linux": "node scripts/build-homepage.cjs",
    "prepublishOnly": "node scripts/build-homepage.cjs",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cicy.desktop",
    "productName": "CiCy Desktop",
    "protocols": [
      {
        "name": "CiCy Desktop URL",
        "schemes": [
          "cicy-desktop",
          "cicy"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "build/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "build/trayTemplate@2x.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "cicybot <support@cicy-ai.com>"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "cicy-ai",
      "repo": "cicy-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "electronVersion": "41.0.3"
  },
  "keywords": [
    "cicy",
    "ai",
    "browser",
    "electron",
    "mcp"
  ],
  "author": {
    "name": "cicybot",
    "email": "support@cicy-ai.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chrome-remote-interface": "^0.33.0",
    "cors": "^2.8.5",
    "electron-context-menu": "^4.0.4",
    "electron-log": "^5.2.4",
    "express": "^4.18.2",
    "i18next": "^26.2.0",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25",
    "electron-updater": "6.6.2"
  },
  "//optionalDependencies": "(2026-06 \u56de\u8c03): mac/linux \u6539\u56de native cicy-code(:8008,colima \u5728 16G mac \u4e0a\u538b\u57ae\u5185\u5b58)\u2192 \u91cd\u65b0\u5185\u7f6e cicy-code-<plat> / cicy-mihomo-<plat>,localbin.fromBundle \u96f6\u7f51\u7edc seed(npm \u4ec5\u4f5c\u66f4\u65b0\u901a\u9053,\u5e26 npmmirror\u2192npmjs \u56de\u9000)\u3002\u8fd9\u4e9b\u7531 scripts/sync-runtime-deps.cjs \u5728 tag-push \u65f6\u540c\u6b65\u5230\u6700\u65b0\u7248\u3002npm \u7684 os/cpu \u5b57\u6bb5\u4fdd\u8bc1\u6bcf\u4e2a\u5e73\u53f0\u53ea\u88c5\u81ea\u5df1\u90a3\u4efd\u3002Windows \u4ecd\u8d70 docker(WSL :8009),\u5b83\u90a3\u4efd cicy-code-windows \u7528\u4e0d\u5230\u4f46 bundle \u7740\u65e0\u5bb3\u3002",
  "optionalDependencies": {
    "electron": "41.0.3",
    "cicy-code-darwin-x64": "2.3.22",
    "cicy-code-darwin-arm64": "2.3.22",
    "cicy-code-linux-x64": "2.3.22",
    "cicy-code-linux-arm64": "2.3.22",
    "cicy-code-windows-x64": "2.3.22",
    "cicy-mihomo-darwin-x64": "1.10.4",
    "cicy-mihomo-darwin-arm64": "1.10.4",
    "cicy-mihomo-linux-x64": "1.10.4",
    "cicy-mihomo-linux-arm64": "1.10.4",
    "cicy-mihomo-windows-x64": "1.10.4",
    "cicy-mihomo-windows-arm64": "1.10.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "axios": "^1.13.5",
    "electron": "41.0.3",
    "electron-builder": "^26.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3"
  }
}
