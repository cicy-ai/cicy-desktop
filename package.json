{
  "name": "cicy-desktop",
  "version": "2.1.179",
  "description": "CiCy - AI-powered operating system browser",
  "main": "src/main.js",
  "bin": {
    "cicy-desktop": "./bin/cicy-desktop",
    "cicy": "./bin/cicy-desktop",
    "cicy-rpc": "./bin/cicy-rpc"
  },
  "scripts": {
    "start": "node ./bin/cicy-desktop",
    "start:master": "node src/master/master-main.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest",
    "test:ls": "node tests/test-ls.js",
    "build": "electron-builder --publish never",
    "build:ui": "cd packages/ui-react && npm install && npm run build",
    "build:homepage": "node scripts/build-homepage.cjs",
    "prebuild:win": "node scripts/build-homepage.cjs",
    "prebuild:mac": "node scripts/build-homepage.cjs",
    "prebuild:linux": "node scripts/build-homepage.cjs",
    "prepublishOnly": "node scripts/build-homepage.cjs",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cicy.desktop",
    "productName": "CiCy Desktop",
    "protocols": [
      {
        "name": "CiCy Desktop URL",
        "schemes": [
          "cicy-desktop",
          "cicy"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "build/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "build/trayTemplate@2x.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "cicybot <support@cicy-ai.com>"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "cicy-ai",
      "repo": "cicy-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "electronVersion": "41.0.3"
  },
  "keywords": [
    "cicy",
    "ai",
    "browser",
    "electron",
    "mcp"
  ],
  "author": {
    "name": "cicybot",
    "email": "support@cicy-ai.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chrome-remote-interface": "^0.33.0",
    "cors": "^2.8.5",
    "electron-context-menu": "^4.0.4",
    "electron-log": "^5.2.4",
    "express": "^4.18.2",
    "i18next": "^26.2.0",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25",
    "electron-updater": "6.6.2"
  },
  "//optionalDependencies": "docker-only(主人): host cicy-code/mihomo 二进制不再内置 —— cicy-code + mihomo 都只在 docker 容器里跑(npm 装/镜像预装),host 永远不起,所以去掉了 cicy-code-<plat> / cicy-mihomo-<plat> 子包。只留 electron。",
  "optionalDependencies": {
    "electron": "41.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "axios": "^1.13.5",
    "electron": "41.0.3",
    "electron-builder": "^26.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3"
  }
}
