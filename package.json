{
  "name": "cicy-desktop",
  "version": "2.1.71",
  "description": "CiCy - AI-powered operating system browser",
  "main": "src/main.js",
  "bin": {
    "cicy-desktop": "./bin/cicy-desktop",
    "cicy": "./bin/cicy-desktop",
    "cicy-rpc": "./bin/cicy-rpc"
  },
  "scripts": {
    "start": "node ./bin/cicy-desktop",
    "start:master": "node src/master/master-main.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest",
    "test:ls": "node tests/test-ls.js",
    "build": "electron-builder --publish never",
    "build:ui": "cd packages/ui-react && npm install && npm run build",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cicy.desktop",
    "productName": "CiCy Desktop",
    "protocols": [
      {
        "name": "CiCy Desktop URL",
        "schemes": [
          "cicy-desktop",
          "cicy"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "build/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "build/trayTemplate@2x.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "cicybot <support@cicy-ai.com>"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "cicy-ai",
      "repo": "cicy-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true
    },
    "electronVersion": "41.0.3"
  },
  "keywords": [
    "cicy",
    "ai",
    "browser",
    "electron",
    "mcp"
  ],
  "author": {
    "name": "cicybot",
    "email": "support@cicy-ai.com"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chrome-remote-interface": "^0.33.0",
    "cors": "^2.8.5",
    "electron-context-menu": "^4.0.4",
    "electron-log": "^5.2.4",
    "express": "^4.18.2",
    "i18next": "^26.2.0",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25",
    "electron-updater": "6.6.2",
    "electron": "41.0.3"
  },
  "//optionalDependencies": "Runtime Bundle v1 (主人指令): platform binaries delivered by `npm i -g cicy-desktop` itself — npm installs only the current-platform subpackage (os/cpu pinned in each), so first start seeds the runtime store with ZERO network, ZERO npx. Windows packages are named *-windows-* (npm spam filter 403s new names containing win32). cicy-msys2 added once published.",
  "optionalDependencies": {
    "cicy-code-darwin-x64": "2.2.5",
    "cicy-code-darwin-arm64": "2.2.5",
    "cicy-code-linux-x64": "2.2.5",
    "cicy-code-linux-arm64": "2.2.5",
    "cicy-code-windows-x64": "2.2.5",
    "cicy-mihomo-darwin-x64": "1.10.4",
    "cicy-mihomo-darwin-arm64": "1.10.4",
    "cicy-mihomo-linux-x64": "1.10.4",
    "cicy-mihomo-linux-arm64": "1.10.4",
    "cicy-mihomo-windows-x64": "1.10.4",
    "cicy-mihomo-windows-arm64": "1.10.4",
    "cicy-msys2-windows-x64": "1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "axios": "^1.13.5",
    "electron-builder": "^26.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3"
  }
}
