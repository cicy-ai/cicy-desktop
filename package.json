{
  "name": "cicy-desktop",
  "version": "2.1.316",
  "description": "CiCy - AI-powered operating system browser",
  "main": "src/main.js",
  "bin": {
    "cicy-desktop": "./bin/cicy-desktop"
  },
  "scripts": {
    "start": "node ./bin/cicy-desktop",
    "test": "node --test \"test/**/*.test.js\"",
    "start:master": "node src/master/master-main.js",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "build": "electron-builder --publish never",
    "build:homepage": "node scripts/build-homepage.cjs",
    "prebuild:win": "node scripts/build-homepage.cjs && node scripts/obfuscate.cjs",
    "prebuild:mac": "node scripts/build-homepage.cjs && node scripts/obfuscate.cjs",
    "prebuild:linux": "node scripts/build-homepage.cjs && node scripts/obfuscate.cjs",
    "prepublishOnly": "node scripts/build-homepage.cjs",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.cicy.desktop",
    "productName": "CiCy Desktop",
    "protocols": [
      {
        "name": "CiCy Desktop URL",
        "schemes": [
          "cicy-desktop",
          "cicy"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/cloudflared",
        "to": "cloudflared"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "build/trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "build/trayTemplate@2x.png"
      },
      {
        "from": "build/trayIcon.png",
        "to": "build/trayIcon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icons",
        "to": "build/icons"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "cicybot <support@cicy-ai.com>"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "cicy-ai",
      "repo": "cicy-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": false,
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "electronVersion": "41.0.3"
  },
  "keywords": [
    "cicy",
    "ai",
    "browser",
    "electron",
    "mcp"
  ],
  "author": {
    "name": "cicybot",
    "email": "support@cicy-ai.com"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "chrome-remote-interface": "^0.33.0",
    "cors": "^2.8.5",
    "electron-context-menu": "^4.0.4",
    "electron-log": "^5.2.4",
    "electron-updater": "6.6.2",
    "express": "^4.18.2",
    "i18next": "^26.2.0",
    "js-beautify": "^1.15.4",
    "js-yaml": "^4.1.1",
    "serve-index": "^1.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25"
  },
  "//optionalDependencies": "(2026-06 回调): mac/linux 改回 native cicy-code(:8008,colima 在 16G mac 上压垮内存)→ 重新内置 cicy-code-<plat> / cicy-mihomo-<plat>,localbin.fromBundle 零网络 seed(npm 仅作更新通道,带 npmmirror→npmjs 回退)。这些由 scripts/sync-runtime-deps.cjs 在 tag-push 时同步到最新版。npm 的 os/cpu 字段保证每个平台只装自己那份。Windows 仍走 docker(WSL :8009),它那份 cicy-code-windows 用不到但 bundle 着无害。",
  "optionalDependencies": {
    "cicy-code-darwin-arm64": "2.3.22",
    "cicy-code-darwin-x64": "2.3.22",
    "cicy-code-linux-arm64": "2.3.22",
    "cicy-code-linux-x64": "2.3.22",
    "cicy-code-windows-x64": "2.3.22",
    "cicy-mihomo-darwin-arm64": "1.10.4",
    "cicy-mihomo-darwin-x64": "1.10.4",
    "cicy-mihomo-linux-arm64": "1.10.4",
    "cicy-mihomo-linux-x64": "1.10.4",
    "cicy-mihomo-windows-arm64": "1.10.4",
    "cicy-mihomo-windows-x64": "1.10.4",
    "electron": "41.0.3"
  },
  "devDependencies": {
    "electron": "41.0.3",
    "electron-builder": "^26.7.0",
    "javascript-obfuscator": "^5.4.7",
    "prettier": "^3.8.1"
  }
}
