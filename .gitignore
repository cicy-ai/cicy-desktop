# Node.js / Electron project ignores
node_modules/
dist/
coverage/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.dev
.env.local
.env.*.local
.vscode/
.idea/
.DS_Store
.npm
.cache/
.worktrees/
.ipynb_checkpoints/
*.ipynb_checkpoints

# build/ holds shipped icons (kept) + transient outputs (.icns/.ico generated
# by CI from logo.svg, kept). The workflow re-generates if missing, but we
# keep what's checked-in as a fallback.
build/*.svg.bak

# Vite/React render subproject — source ships, build artefacts do not.
workers/render/node_modules/
workers/render/dist/

# Manual snapshot of workers/render kept locally for rollback; not part of
# the release.
workers/render.bak.*

# Legacy render dir moved out of cicy-code; not part of cicy-desktop releases.
workers/desktop-render/

# cloudflared bundle binaries (build assets, per-arch) — not source
resources/cloudflared/cloudflared-darwin-*

# Panel pages copied from src/tabbrowser by scripts/build-homepage.cjs — generated,
# never edit here (src/tabbrowser is the source of truth).
workers/render/public/panel/
