# Node.js / Electron project ignores
node_modules/
dist/
coverage/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local
.vscode/
.idea/
.DS_Store
.npm
